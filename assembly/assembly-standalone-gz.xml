<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
    <id>standalone-tar-gz</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    
    <fileSets>
        <fileSet>
            <directory>../drivers</directory>
            <outputDirectory>drivers</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>../mapFiles</directory>
            <outputDirectory>data/map</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>../staticResource</directory>
            <outputDirectory>data/static-resource</outputDirectory>
        </fileSet>
    </fileSets>
    
	<files>
        <file>
            <source>../start.bat</source>
            <outputDirectory>.</outputDirectory>
        </file>
        <file>
            <source>../start.sh</source>
            <outputDirectory>.</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>../install.md</source>
            <outputDirectory>.</outputDirectory>
        </file>
        <file>
            <source>../core/core-backend/target/CoreApplication.jar</source>
            <outputDirectory>.</outputDirectory>
        </file>
    </files>
    
</assembly>